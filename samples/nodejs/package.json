{
  "name": "sonar-samples-nodejs",
  "version": "1.0.0",
  "description": "Minimal Node.js app for SonarQube analysis sample",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-sonar": "^0.2.16"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "reporters": [
      "default",
      [
        "jest-sonar",
        {
          "outputDirectory": "coverage",
          "outputName": "test-report.xml"
        }
      ]
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
